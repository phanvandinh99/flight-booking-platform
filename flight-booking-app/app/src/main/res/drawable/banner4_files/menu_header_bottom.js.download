$(document).ready(function(){$('ul.desktop .menu-item').hover(function(e){e.preventDefault();if($(this).is(':hover')||$(this).hasClass('menu-open')){$(this).find(".icon-before").hide();$(this).find(".icon-after").show();$(this).find(".name").addClass('active')}else{$(this).find(".icon-before").show();$(this).find(".icon-after").hide();$(this).find(".name").removeClass('active')}})});$(document).ready(function(){$('ul.mobile .menu-item, ul.desktop .menu-item').click(function(e){if($(this).hasClass('menu-open')){$(this).removeClass('menu-open');$(this).find('.sub-menu').removeClass('menu-drop');$(".menu-header-bottom").removeClass('active');$(this).find(".icon-before").show();$(this).find(".icon-after").hide();$(this).find(".name").removeClass('active');$(this).find(".menu").removeClass('triangle');if($(this).parent().hasClass('mobile')){$('.menu-item').css("margin-bottom",0)}}else{if($(this).children().hasClass('sub-menu')){if($(window).scrollTop()<300){$('html, body').animate({scrollTop:300},500)}
$('.menu-open').removeClass('menu-open');$('.menu-drop').removeClass('menu-drop');$('.menu-item').css("margin-bottom",0);$(".name").removeClass('active');$(".menu").removeClass('triangle');$(".icon-before").show();$(".icon-after").hide();$(this).addClass('menu-open');$(this).find('.sub-menu').addClass('menu-drop');$(".menu-header-bottom").addClass('active');$(this).find(".icon-before").hide();$(this).find(".icon-after").show();$(this).find(".name").addClass('active');$(this).find(".menu").addClass('triangle');if($(this).parent().hasClass('mobile')){var hightSubmenu=$(this).find(".sub-menu").height();$(this).css("margin-bottom",+hightSubmenu+10)}}}})});function open_tab_booking_mobile(){$("#mb-manage-booking-popup").on("shown.bs.modal",function(){}).modal('show')}
function open_lotus_signup(){$('.lotus-signup').toggleClass("active");$("html, body").animate({scrollTop:0},500);$(".overlay").css({"z-index":11,}).fadeIn()}
function open_lotus_signup_mobile(){$("#navbar-collapse-top").addClass("slideInLeft");$("body").addClass("nav-showing");$("html").addClass("navtabht-showing")}