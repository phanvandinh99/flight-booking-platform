        border-radius: 5px;
        border: 1px solid #ccc;
    }

    .submit-btn {
        width: 120px;
        padding: 10px;
        font-size: 16px;
        background: #246191;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        margin: 0px 0px 0px 13px;
    }

    .error-msg {
