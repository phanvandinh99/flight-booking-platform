function LoginMembershipAccount(){var sabreLang=$('#hdfSabreLang').val();var locale="en-US";switch(sabreLang){case "vi_VN":locale="vi-VI";break;case "fr_FR":locale="fr-FR";break;case "de_DE":locale="de-DE";break;case "zh_TW":locale="zh-TW";break;case "en":locale="en-US";break;case "zh_CN":locale="zh-CN";break;case "ru_RU":locale="ru-RU";break;case "ko_KR":locale="ko-KR";break;case "ja_JP":locale="ja-JP";break}
