                <div id="mylanguage" class="dd-container" style="width: 307px;"><div class="dd-select" style="width: 307px; background: rgb(255, 255, 255);"><input class="dd-selected-value" type="hidden" value="E0E6B177-469F-4152-8430-426026AC3732"><a class="dd-selected"><p class="dd-selected-text">Tiếng Việt</p><small class="dd-selected-description dd-desc dd-selected-description-truncated">flag flag-vn</small></a><span class="dd-pointer dd-pointer-down"></span></div><ul class="dd-options dd-click-off-close" style="width: 307px;"><li><a class="dd-option"> <input class="dd-option-value" type="hidden" value="527AE4A7-C828-4380-91CD-2F958CDAFEE6"> <p class="dd-option-text">English</p> <small class="dd-option-description dd-desc">flag flag-vn</small></a></li><li><a class="dd-option dd-option-selected"> <input class="dd-option-value" type="hidden" value="E0E6B177-469F-4152-8430-426026AC3732"> <p class="dd-option-text">Tiếng Việt</p> <small class="dd-option-description dd-desc">flag flag-vn</small></a></li></ul></div></div>
