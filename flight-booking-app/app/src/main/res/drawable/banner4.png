<div id="store-notify" class="col-xs-12">
    <div id="vna-app-logo" class="col-xs-2">
        <a href="https://www.vietnamairlines.com/vn/vi/home?utm_source=accesstrade&amp;aff_sid=vtqKsZmlbikyg58N5VbNTBqPe2E8cGxDbObgKx1762338147&amp;gad_source=1#">VNA App</a>
    </div>
    <div class="col-xs-10">

        
        Vietnam Airlines
        <p class="small-text">
            Hãy trải nghiệm Ứng dụng mới của chúng tôi!
            
        </p>

        <div class="text-center">
            <div id="appstore" class="col-xs-6" style="">Appstore</div>
            <div id="playstore" class="col-xs-6" style="display: none">Playstore</div>
            <div id="appGallery" class="col-xs-6" style="display: none">AppGallery</div>
        </div>
    </div>
    <a href="https://www.vietnamairlines.com/vn/vi/home?utm_source=accesstrade&amp;aff_sid=vtqKsZmlbikyg58N5VbNTBqPe2E8cGxDbObgKx1762338147&amp;gad_source=1#close-notify" id="close-notify">Close</a>
</div>
<script>

    $(document).ready(function() {
        $('#store-notify > #close-notify').on("click tap",
            function() {
                $('#store-notify').hide();
            });

        if (navigator.userAgent.match(/iPhone|iPad|iPod/i)) {
            $("#appstore").show();
        }  else if (navigator.userAgent.match(/Android/i)) {
            $("#playstore").show();
        } else {          
            $("#appstore").show();
            $("#playstore").show();
         
        }

        $("#playstore").click(function() {
            var now = new Date().valueOf();
            setTimeout(function() {
                    if (new Date().valueOf() - now > 100) return;
                    //window.location = "market://details?id=com.vietnamairlines.android.app";
                    if ($("#hdfLink_Playstore").val() != '' && $("#hdfLink_Playstore").val() != undefined) {
                        window.location.href = $("#hdfLink_Playstore").val();
                    }
                },
                300);
            if ($("#hdfDeeplink_Playstore").val() != '' && $("#hdfDeeplink_Playstore").val() != undefined) {
                window.location = $("#hdfDeeplink_Playstore").val();
            }
            return false;
        });

        $("#appstore").click(function() {

            var now = new Date().valueOf();
            setTimeout(function() {
                    //window.location = "https://itunes.apple.com/vn/app/vietnam-airlines/id691073295?mt=8";//play store URL.
                    if ($("#hdfDeeplink_Appstore").val() != '' && $("#hdfDeeplink_Appstore").val() != undefined) {
                        window.location.href = $("#hdfDeeplink_Appstore").val();
                    }
                },
                300);
            if ($("#hdfLink_Appstore").val() != '' && $("#hdfLink_Appstore").val() != undefined) {
                window.location = $("#hdfLink_Appstore").val(); //custom url
            }
            return false;
        });

        $("#appGallery").click(function () {

            var now = new Date().valueOf();
            setTimeout(function () {
                //window.location = "https://appgallery.cloud.huawei.com/ag/n/app/C102223647?channelId=web&detailType=0";//gallery store URL.
                if ($("#hdfDeeplink_AppGallery").val() != '' && $("#hdfDeeplink_AppGallery").val() != undefined) {
                    window.location.href = $("#hdfDeeplink_AppGallery").val();
                }
            },
                300);
            if ($("#hdfLink_AppGallery").val() != '' && $("#hdfLink_AppGallery").val() != undefined) {
                window.location = $("#hdfLink_AppGallery").val(); //custom url
            }
            return false;
        });
    });
</script>
