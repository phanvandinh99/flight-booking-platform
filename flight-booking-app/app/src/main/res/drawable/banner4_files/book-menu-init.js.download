function formatDateToYyyyMMDd(dateVN){if(!dateVN){return""}
if(typeof dateVN.toString==="function"){dateVN=dateVN.toString()}
let list=dateVN.split("/");if(list.length<3){list=dateVN.split("-")}
if(list.length!==3){return""}
return list[2]+"-"+list[1]+"-"+list[0]}
