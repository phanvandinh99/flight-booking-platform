<!--content-wrapper-->
<script type="text/javascript">
    jQuery(function ($) {
        function showMessage(msg, callBackOkBtn, callBackOnClose) {
            msgHelper.showAlert(msg, $("#hdfNotice").val(), function () {
                if (callBackOkBtn) callBackOkBtn();
            }, null, function (e) {
                if (!e) { //btn NO or Close click
                    if (callBackOnClose) callBackOnClose();
                }
            });
        }
        function resetValueInput() {
            $("#subcribeLastName").val("");
            $("#subcribeFullName").val("");
            $("#subcribeEmail").val("");
            $("#subcribe-newsletter-form input[name=byt-agree]").prop("checked", false);
            $("#subcribe-newsletter-form input[name=byt-agree]").trigger("change");
        }

		$("input[id$='btnSubcribe']:first").click(function(e) {
			e.preventDefault();
			var valid = $('#subcribe-newsletter-form').validationEngine('validate');
            if (valid) {
                $(".overloadpage").show();
                $(".spin-loader").show();
                var title = $("select[id$='ddlSubcribeTitleGender']:first").find(":selected").text();
                var firstName = (title + " " + $("#subcribeFullName").val()).trim();
                var lastName = $("#subcribeLastName").val().trim();
                var email = $("#subcribeEmail").val().trim();
				var countryCode = $("select[id$='ddlSubcribeRegion']:first").find(":selected").val();
				var langCode = $("select[id$='ddlSubcribeLanguage']:first").find(":selected").val();				
                if (langCode == 'VN') {
                    langCode = 'VI';
                } else {
                    langCode = "EN"
                }

				$(document.body).trigger('gtm_event_tracking', ['User Action', 'Subscribe', ' ']);
                var isSub = true;
                // Check if an ID exists in local storage
                let deviceId = localStorage.getItem('deviceId');
                if (!deviceId) {
                    deviceId = crypto.randomUUID();
                    localStorage.setItem('deviceId', deviceId);
                }

                var requestModel = {
                    DeviceId: deviceId,
                    Gaid: (typeof gaGlobal != 'undefined' && gaGlobal) ? gaGlobal.vid : '',
                    Sub: isSub ? 1 : 0,
                    Email: email,
                    Phone: "",
                    Language: langCode,
                    Lastname: lastName,
                    FirstName: firstName,
                    Country: countryCode,
                }
                $.ajax({
                    type: "POST",
                    url: "/WebApi/CD/MSSFServices.asmx/SubmitConsent",
                    data: "{requestModel: " + JSON.stringify(requestModel) + "}",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        if (data.d && isJsonString(data.d)) {
                            var objResult = JSON.parse(data.d);
                            if (objResult.status === "success") {
                                if (!isSub) {
                                    showMessage($("#hdfMsgUnsubcribeSuccessfully").val());
                                } else {
                                    showMessage($("#hdfMsgSubcribeSuccessfully").val());
                                }
                                resetValueInput();
                            } else {
                                if (objResult.errors != null && objResult.errors[0] != null) {                                    
                                    if (!isSub) {
                                        showMessage($("#hdfMsgUnsubcribeFailed").val());
                                    } else {
                                        showMessage($("#hdfMsgSubcribeFailed").val());
                                    }
                                }
                                else if (objResult.code == '400' && objResult.message == 'Input is invalid format or contains unsafe key') {
                                    showMessage($("#hdfMsgENewsInvalidInput").val());
                                } else {
                                    showMessage($("#hdfmsgSubcribeUnknownError").val());
                                }
                            }

                        } else {
                            showMessage($("#hdfmsgSubcribeUnknownError").val());
                        }
                        $(".overloadpage").hide();
                        $(".spin-loader").hide();
                    },
                    complete: function (data) {
                        $(".overloadpage").hide();
                        $(".spin-loader").hide();
                    },
                    error: function (errMsg) {
                        showMessage($("#hdfmsgSubcribeUnknownError").val());
                        $(".overloadpage").hide();
                        $(".spin-loader").hide();
                    }
                });
			}
			return !1
		})
	}) 
</script>

